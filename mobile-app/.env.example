# The web app this mobile app opens.
# {subdomain} is replaced by SUBDOMAIN below, or asked from the user on first launch.
WEB_URL=https://{subdomain}.softproit.cloud

# Leave empty: the app asks for the subdomain on first launch (e.g. "cb2" -> https://cb2.softproit.cloud).
# Filled (e.g. SUBDOMAIN=cb2): the APK opens that institution directly; the setup screen
# and the "Change subdomain" option are hidden.
SUBDOMAIN=
